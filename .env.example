# AFAD Yönetim Sistemi - Örnek Ortam Değişkenleri

# Uygulama
APP_NAME=AFAD Yönetim Sistemi
APP_VERSION=1.0.0
DEBUG=True

# Sunucu
HOST=0.0.0.0
PORT=8000

# Veritabanı
# SQLite için:
DATABASE_URL=sqlite:///./database/afad.db

# PostgreSQL için:
# DATABASE_URL=postgresql://kullanici:sifre@localhost/afad_db

# Güvenlik
SECRET_KEY=your-secret-key-change-this-in-production-afad2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080

# Email (Opsiyonel)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-password

# SMS (Opsiyonel)
SMS_API_KEY=your-sms-api-key
SMS_API_URL=https://api.sms-provider.com/send
